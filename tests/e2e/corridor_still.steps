shot cs_1
hold left 0.4
wait 1.5
shot cs_2
hold left 0.8
wait 1.5
shot cs_3_back
hold left 0.8
wait 1.5
shot cs_4
keydown y
wait 1.0
keyup y
wait 1.5
shot cs_5_up
