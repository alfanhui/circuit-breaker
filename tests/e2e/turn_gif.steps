shot gif_ease_14
shot gif_ease_15
shot gif_ease_16
shot gif_ease_17
shot gif_ease_18
shot gif_ease_19
shot gif_ease_20
shot gif_ease_21
shot gif_ease_22
shot gif_ease_23
shot gif_ease_24
shot gif_ease_25
shot gif_ease_26
shot gif_ease_27
shot gif_ease_28
shot gif_ease_29
wait 1.5
press z
wait 2
shot gif_linear_pre
press right
