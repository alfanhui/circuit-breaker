# Your body (game/body.h), in the mirror and from your own eyes: stood, running at the glass (the
# hands pump into view, the mirror shows the same stride), at the glass, and looking down at it
wait_up
hold left 1.3
shot body_0a_turned
hold up 2.6
wait 0.6
shot body_00_stood
keydown up
wait 0.45
shot body_01_run
wait 0.12
shot body_02_run
wait 0.12
shot body_03_run
wait 0.12
shot body_04_run
wait 0.12
shot body_05_run
keyup up
wait 0.8
shot body_06_at_glass
hold b 0.6
shot body_07_look_down
