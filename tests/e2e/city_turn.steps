hold right 0.2
shot ctn_01
hold right 0.2
shot ctn_02
hold right 0.2
shot ctn_03
hold right 0.2
shot ctn_04
hold right 0.2
shot ctn_05
hold right 0.2
shot ctn_06
hold right 0.2
shot ctn_07
hold right 0.2
shot ctn_08
hold right 0.2
shot ctn_09
hold right 0.2
shot ctn_10
hold right 0.2
shot ctn_11
